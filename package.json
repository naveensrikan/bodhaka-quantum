{
  "name": "bodhaka-quantum-summit",
  "version": "0.1.0",
  "description": "Bodhaka Quantum Summit: a quantum-native terminal for running authentic Qiskit on real IBM Quantum hardware.",
  "author": "BuoyantWave Learning Technologies",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder --win",
    "build:exe": "vite build && electron-builder --win nsis",
    "build:msix": "vite build && electron-builder --win appx"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  }
}
